# ============================================
# 中间件环境变量模板 (.scripts/docker/.env.docker)
# 复制为 .env.docker 后可按需调整
# ============================================

# 部署规格: mini(1) | standard(2) | full(3，默认)
# mini     — 边缘精简版，推荐宿主机内存 ≥ 4 GB
# standard — 标准版，推荐宿主机内存 ≥ 16 GB
# full     — 完整版，推荐宿主机内存 ≥ 20 GB
EASYAIOT_DEPLOY_PROFILE=full

# SRS 调用 VIDEO 私有回调的宿主机地址。VIDEO 仅绑定 Docker bridge 时，
# 请设置为对应网关（例如 172.17.0.1），不要填写 URL scheme。
VIDEO_CALLBACK_HOST=172.17.0.1

# SRS HTTP Hook shared token. Generate at least 32 URL-safe random characters
# and use the same value in VIDEO/.env.docker.
YFEIEYE_SRS_HOOK_TOKEN=

# Shared persistent root for all middleware state. In production this must stay outside the
# release/current symlink so deploy switches and release cleanup cannot break
# running container bind mounts.
YFEIEYE_DOCKER_DATA_ROOT=/opt/yfeieye-source/shared/docker
# Empty Nacos state is accepted only for an explicit first-time installation.
# Set true for the first boot only, then restore false after /home/nacos/data is populated.
YFEIEYE_NACOS_ALLOW_EMPTY_DATA_INIT=false

# PostgreSQL 连接串及密码，供健康检查/工具脚本使用
POSTGRES_PASSWORD=iot45722414822
DATABASE_URL=postgresql://postgres:${POSTGRES_PASSWORD}@PostgresSQL:5432/iot-ai20

# Nacos 访问配置（所有业务容器保持一致）
NACOS_SERVER=Nacos:8848
NACOS_NAMESPACE=
NACOS_USERNAME=nacos
NACOS_PASSWORD=basiclab@iot78475418754

# MinIO 对象存储配置
MINIO_ENDPOINT=MinIO:9000
MINIO_BASE_URL=http://MinIO:9000
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_SECURE=false

# Redis / Kafka / EMQX 等中间件域名与凭证
REDIS_HOST=Redis
REDIS_PORT=6379
REDIS_PASSWORD=basiclab@iot975248395
KAFKA_BOOTSTRAP_SERVERS=Kafka:9092
# IoT 业务主题目标分区数（install_middleware_linux.sh init_kafka_iot_topics 使用，默认 64）
# 含：告警、抓拍告警、人脸匹配、车牌匹配
KAFKA_IOT_TOPIC_PARTITIONS=64
# 兼容旧变量名
KAFKA_ALERT_TOPIC_PARTITIONS=64
EMQX_BROKER=EMQX:1883
EMQX_DASHBOARD_PASSWORD=basiclab@iot6874125784

# 默认时区
TZ=Asia/Shanghai

# FUXA 组态镜像（默认 proxy.vvvv.ee，实测比 docker.1ms.run 更稳）
# FUXA_IMAGE=proxy.vvvv.ee/frangoteam/fuxa:1.3.3
# 备选: docker.1panel.live/frangoteam/fuxa:1.3.3
